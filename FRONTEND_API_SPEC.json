    {
      "id": "bills_pay",
      "endpoint": "/bills/pay/",
      "method": "POST",
      "authentication_required": true,
      "description": "Pay utility bill",
      "category": "Bill Payments",
      "fields": [
        {
          "name": "category",
          "label": "Bill Category",
          "type": "select",
          "required": true,
          "options": [
            { "value": "ELECTRICITY", "label": "Electricity" },
            { "value": "WATER", "label": "Water" },
            { "value": "INTERNET", "label": "Internet" },
            { "value": "TV", "label": "TV/Cable" },
            { "value": "OTHER", "label": "Other" }
          ],
          "helpText": "Select the type of bill you're paying"
        },
        {
          "name": "provider_name",
          "label": "Provider Name",
          "type": "text",
          "required": true,
          "validation": {
            "maxLength": 100,
            "trim": true,
            "notEmpty": true
          },
          "placeholder": "SOMELEC",
          "helpText": "Enter the utility provider name (e.g., SOMELEC, Mauritel)",
          "examples": {
            "ELECTRICITY": ["SOMELEC"],
            "WATER": ["SNDE"],
            "INTERNET": ["Mauritel", "Mattel", "Chinguitel"],
            "TV": ["Canal+"]
          }
        },
        {
          "name": "account_number",
          "label": "Account Number",
          "type": "text",
          "required": true,
          "validation": {
