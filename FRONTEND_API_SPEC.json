    {
      "id": "transfers_send",
      "endpoint": "/transfers/send/",
      "method": "POST",
      "authentication_required": true,
      "description": "Send money to another user",
      "category": "Transfers",
      "fields": [
        {
          "name": "recipient_username",
          "label": "Recipient Username",
          "type": "text",
          "required": false,
          "validation": {
            "conditionallyRequired": "Either recipient_username OR recipient_phone must be provided"
          },
          "placeholder": "jane_doe",
          "helpText": "Enter username OR phone number of recipient"
        },
        {
          "name": "recipient_phone",
          "label": "Recipient Phone",
          "type": "tel",
          "required": false,
          "validation": {
            "pattern": "^[234]\\d{7}$",
            "conditionallyRequired": "Either recipient_username OR recipient_phone must be provided"
          },
          "placeholder": "36600200",
          "helpText": "Enter phone OR username of recipient"
        },
        {
          "name": "amount",
          "label": "Amount (MRU)",
          "type": "number",
          "inputMode": "decimal",
          "required": true,
          "validation": {
            "min": 1,
            "max": 999999999999,
            "decimalPlaces": 2,
            "step": 0.01
          },
          "placeholder": "100.00",
          "helpText": "Transfer amount (fee will be calculated automatically)"
        },
        {
          "name": "note",
          "label": "Note (Optional)",
          "type": "text",
          "required": false,
          "validation": {
            "maxLength": 255
          },
          "placeholder": "Payment for lunch",
          "helpText": "Add an optional note to the transfer"
        }
      ],
      "validation_rules": {
        "custom": [
          "Cannot send money to yourself",
          "Must provide either recipient_username OR recipient_phone (not both)",
          "Sender must have sufficient balance (amount + fee)",
          "Both wallets must be unlocked"
        ]
      },
      "response": {
        "success_code": 201,
        "success_response": {
          "detail": "Transfer successful",
          "transfer": {
            "id": "uuid",
            "sender_wallet": "uuid",
            "receiver_wallet": "uuid",
            "sender_info": {
              "username": "string",
              "phone": "string"
            },
            "receiver_info": {
              "username": "string",
              "phone": "string"
            },
            "amount": "100.00",
            "note": "string",
            "status": "SUCCESS",
            "reference": "XFER-timestamp-unique",
            "created_at": "datetime"
          },
          "fee_charged": "2.00",
          "total_deducted": "102.00"
        }
      }
    },

