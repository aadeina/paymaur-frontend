{
  "api_metadata": {
    "name": "PayMaur API",
    "version": "1.0.0",
    "base_url": "http://localhost:8000/api/v1",
    "description": "Complete API specification for PayMaur fintech platform - Wallet, Transfers, Bill Payments, and more",
    "authentication": {
      "type": "JWT Bearer Token",
      "header": "Authorization: Bearer {access_token}",
      "token_endpoints": {
        "login": "/auth/login/",
        "refresh": "/auth/token/refresh/",
        "logout": "/auth/logout/"
      },
      "token_lifetime": {
        "access": "60 minutes",
        "refresh": "7 days"
      }
    }
  },

  "endpoints": [
    {
      "id": "auth_register",
      "endpoint": "/auth/register/",
      "method": "POST",
      "authentication_required": false,
      "description": "Register a new user account",
      "category": "Authentication",
      "fields": [
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "validation": {
            "pattern": "^[234]\\d{7}$",
            "minLength": 8,
            "maxLength": 8,
            "customRule": "Must be 8 digits starting with 2, 3, or 4"
          },
          "placeholder": "36600100",
          "helpText": "Enter your Mauritanian phone number (8 digits)",
          "errorMessages": {
            "required": "Phone number is required",
            "pattern": "Phone must be 8 digits starting with 2, 3, or 4",
            "unique": "This phone number is already registered"
          }
        },
        {
          "name": "username",
          "label": "Username",
          "type": "text",
          "required": true,
          "validation": {
            "maxLength": 30,
            "unique": true
          },
          "placeholder": "john_doe",
          "helpText": "Choose a unique username",
          "errorMessages": {
            "required": "Username is required",
            "maxLength": "Username cannot exceed 30 characters",
            "unique": "This username is already taken"
          }
        },
        {
          "name": "pin",
          "label": "4-Digit PIN",
          "type": "password",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "minLength": 4,
            "maxLength": 4,
            "pattern": "^\\d{4}$"
          },
          "placeholder": "••••",
          "helpText": "Create a 4-digit PIN for secure login",
          "errorMessages": {
            "required": "PIN is required",
            "pattern": "PIN must be exactly 4 digits",
            "minLength": "PIN must be 4 digits",
            "maxLength": "PIN must be 4 digits"
          },
          "security": "Stored as Argon2 hash, never in plain text"
        }
      ],
      "response": {
        "success_code": 201,
        "success_response": {
          "success": true,
          "message": "User registered. OTP sent for verification."
        },
        "next_step": "Verify OTP at /auth/verify-otp/"
      }
    },

    {
      "id": "auth_verify_otp",
      "endpoint": "/auth/verify-otp/",
      "method": "POST",
      "authentication_required": false,
      "description": "Verify OTP code sent during registration or PIN reset",
      "category": "Authentication",
      "fields": [
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "validation": {
            "pattern": "^[234]\\d{7}$"
          },
          "placeholder": "36600100"
        },
        {
          "name": "code",
          "label": "OTP Code",
          "type": "text",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "length": 6,
            "pattern": "^\\d{6}$"
          },
          "placeholder": "123456",
          "helpText": "Enter the 6-digit code sent to your phone",
          "autoComplete": "one-time-code"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "success": true,
          "message": "OTP verified successfully"
        },
        "next_step": "User is verified and can login"
      }
    },

    {
      "id": "auth_login",
      "endpoint": "/auth/login/",
      "method": "POST",
      "authentication_required": false,
      "description": "Login with phone number and PIN",
      "category": "Authentication",
      "fields": [
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "validation": {
            "pattern": "^[234]\\d{7}$"
          },
          "placeholder": "36600100",
          "autoComplete": "tel"
        },
        {
          "name": "pin",
          "label": "PIN",
          "type": "password",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "length": 4
          },
          "placeholder": "••••",
          "autoComplete": "current-password"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "success": true,
          "message": "Login successful",
          "data": {
            "access": "jwt_access_token",
            "refresh": "jwt_refresh_token",
            "user": {
              "id": "uuid",
              "username": "string",
              "phone": "string",
              "is_verified": true
            }
          }
        },
        "storage": {
          "access_token": "localStorage",
          "refresh_token": "localStorage",
          "user_data": "localStorage"
        }
      }
    },

    {
      "id": "auth_logout",
      "endpoint": "/auth/logout/",
      "method": "POST",
      "authentication_required": true,
      "description": "Logout and blacklist refresh token",
      "category": "Authentication",
      "fields": [
        {
          "name": "refresh",
          "label": "Refresh Token",
          "type": "hidden",
          "required": true,
          "source": "localStorage",
          "helpText": "Automatically populated from stored refresh token"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "success": true,
          "message": "Logged out successfully"
        },
        "cleanup": "Clear all tokens and user data from localStorage"
      }
    },

    {
      "id": "auth_token_refresh",
      "endpoint": "/auth/token/refresh/",
      "method": "POST",
      "authentication_required": false,
      "description": "Refresh access token using refresh token",
      "category": "Authentication",
      "fields": [
        {
          "name": "refresh",
          "label": "Refresh Token",
          "type": "hidden",
          "required": true,
          "source": "localStorage"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "access": "new_jwt_access_token"
        },
        "storage": {
          "access_token": "Update in localStorage"
        }
      }
    },

    {
      "id": "auth_change_pin",
      "endpoint": "/auth/pin/change/",
      "method": "POST",
      "authentication_required": true,
      "description": "Change user PIN (must be logged in)",
      "category": "Authentication",
      "fields": [
        {
          "name": "old_pin",
          "label": "Current PIN",
          "type": "password",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "length": 4,
            "pattern": "^\\d{4}$"
          },
          "placeholder": "••••"
        },
        {
          "name": "new_pin",
          "label": "New PIN",
          "type": "password",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "length": 4,
            "pattern": "^\\d{4}$"
          },
          "placeholder": "••••",
          "helpText": "Create a new 4-digit PIN"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "success": true,
          "message": "PIN changed successfully"
        }
      }
    },

    {
      "id": "auth_forgot_pin_start",
      "endpoint": "/auth/pin/forgot/start/",
      "method": "POST",
      "authentication_required": false,
      "description": "Start PIN reset process - sends OTP",
      "category": "Authentication",
      "fields": [
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "validation": {
            "pattern": "^[234]\\d{7}$"
          },
          "placeholder": "36600100"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "success": true,
          "message": "OTP sent for PIN reset"
        },
        "next_step": "Verify OTP at /auth/pin/forgot/verify/"
      }
    },

    {
      "id": "auth_forgot_pin_verify",
      "endpoint": "/auth/pin/forgot/verify/",
      "method": "POST",
      "authentication_required": false,
      "description": "Verify OTP for PIN reset",
      "category": "Authentication",
      "fields": [
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "placeholder": "36600100"
        },
        {
          "name": "code",
          "label": "OTP Code",
          "type": "text",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "length": 6
          },
          "placeholder": "123456"
        }
      ],
      "response": {
        "success_code": 200,
        "next_step": "Set new PIN at /auth/pin/reset/"
      }
    },

    {
      "id": "auth_reset_pin",
      "endpoint": "/auth/pin/reset/",
      "method": "POST",
      "authentication_required": false,
      "description": "Complete PIN reset with new PIN",
      "category": "Authentication",
      "fields": [
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "required": true,
          "placeholder": "36600100"
        },
        {
          "name": "new_pin",
          "label": "New PIN",
          "type": "password",
          "inputMode": "numeric",
          "required": true,
          "validation": {
            "length": 4,
            "pattern": "^\\d{4}$"
          },
          "placeholder": "••••"
        }
      ],
      "response": {
        "success_code": 200,
        "success_response": {
          "success": true,
          "message": "PIN reset successfully"
        },
        "next_step": "Login with new PIN"
      }
    },

