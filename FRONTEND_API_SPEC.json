  "common_validation_patterns": {
    "phone": {
      "pattern": "^[234]\\d{7}$",
      "description": "Mauritanian phone number: 8 digits starting with 2, 3, or 4",
      "examples": ["36600100", "22334455", "44556677"]
    },
    "pin": {
      "pattern": "^\\d{4}$",
      "description": "4-digit PIN",
      "security": "Always stored as Argon2 hash"
    },
    "otp": {
      "pattern": "^\\d{6}$",
      "description": "6-digit OTP code",
      "expiry": "5 minutes"
    },
    "amount": {
      "min": 1,
      "max": 999999999999,
      "decimalPlaces": 2,
      "description": "Monetary amount in MRU"
    },
    "username": {
      "maxLength": 30,
      "unique": true,
      "description": "Unique username identifier"
    }
  },

  "error_handling": {
    "standard_error_format": {
      "detail": "Error message string"
    },
    "validation_error_format": {
      "field_name": ["Error message 1", "Error message 2"]
    },
    "http_status_codes": {
      "200": "Success",
      "201": "Created",
      "400": "Bad Request (validation errors)",
      "401": "Unauthorized (invalid/missing token)",
      "403": "Forbidden (insufficient permissions)",
      "404": "Not Found",
      "500": "Internal Server Error"
    }
  },

  "frontend_implementation_notes": {
    "authentication_flow": [
      "1. Register → Verify OTP → Login",
      "2. Store access_token and refresh_token in localStorage",
      "3. Include Authorization: Bearer {access_token} header in all protected requests",
      "4. Automatically refresh token when it expires (60 min lifetime)",
      "5. Clear all tokens on logout"
    ],
    "transfer_flow": [
      "1. Search/select recipient",
      "2. Enter amount",
      "3. Calculate fee using /fees/calculate/",
      "4. Show fee preview to user",
      "5. Confirm and send via /transfers/send/",
      "6. Show success with transfer reference"
    ],
    "bill_payment_flow": [
      "1. Select category",
      "2. Enter provider and account details",
      "3. Enter amount",
      "4. Generate unique idempotency_key (UUID)",
      "5. Submit payment",
      "6. Show receipt with reference number"
    ],
    "form_validation_priorities": [
      "1. Client-side validation (instant feedback)",
      "2. Show validation errors inline",
      "3. Disable submit button until form is valid",
      "4. Handle server-side validation errors gracefully",
      "5. Provide clear error messages"
    ],
    "ui_ux_recommendations": [
      "1. Show balance prominently on dashboard",
      "2. Recent transactions on home screen",
      "3. Quick actions: Transfer, Pay Bill, Check Balance",
      "4. Transaction history with filters",
      "5. Fee preview before confirming transfers",
      "6. Clear success/error notifications",
      "7. Responsive design for mobile-first",
      "8. Accessibility (ARIA labels, keyboard navigation)"
    ]
  }
}
